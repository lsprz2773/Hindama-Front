# Variables del BFF (solo servidor). Copia este archivo a .env.local; nunca subas .env.local.
# Valores públicos del User Pool de desarrollo: guía del frontend (hindama-docs), sección 2.1.
COGNITO_REGION=
COGNITO_CLIENT_ID=
# Secreto del cliente confidencial: léelo de SSM (guía del frontend, sección 2.1, paso 4).
COGNITO_CLIENT_SECRET=
# URL privada de la API de la plataforma (en local, http://localhost:8000).
HINDAMA_API_URL=
# Origen público del frontend, para verificar Origin (en local, https://localhost:3000).
HINDAMA_PUBLIC_ORIGIN=
# Llave AES-256 de la cookie de sesión (32 bytes en base64). En producción se lee de SSM con
# HINDAMA_SESSION_KEY_PARAMETER; en desarrollo puede copiarse de SSM a HINDAMA_SESSION_KEY.
HINDAMA_SESSION_KEY_PARAMETER=
HINDAMA_SESSION_KEY=
